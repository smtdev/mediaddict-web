---
import '@fontsource-variable/bricolage-grotesque/index.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/500.css';
import '../styles/landing.css';
import { landing, PLAY_URL } from '../landing-copy';
import { href, ui, EMAIL, type Lang } from '../i18n';
import demoEs from '../data/demo.es.json';
import demoEn from '../data/demo.en.json';
import appIcon from '../assets/app-icon.svg?raw';
import tmdb from '../assets/tmdb_logo.svg?raw';
import trakt from '../assets/trakt_logo.svg?raw';
import simkl from '../assets/ic_simkl_logo.svg?raw';
import tvdb from '../assets/tvdb_logo_oficial.svg?raw';
import justwatch from '../assets/justwatch_logo.svg?raw';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = landing[lang];
const t = ui[lang];
const demo = lang === 'en' ? demoEn : demoEs;
const site = 'https://mediaddict.app';
const abs = (l: Lang) => (l === 'en' ? site : site + '/es/');
const sunMoon = `<svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7z" fill="currentColor"/></svg>`;
const logos = [
  { href: 'https://www.themoviedb.org', name: 'TMDB', cls: 'light', svg: tmdb },
  { href: 'https://trakt.tv', name: 'Trakt', cls: '', svg: trakt },
  { href: 'https://simkl.com', name: 'Simkl', cls: 'light sm', svg: simkl },
  { href: 'https://thetvdb.com', name: 'TheTVDB', cls: '', svg: tvdb },
  { href: 'https://www.justwatch.com', name: 'JustWatch', cls: 'wide', svg: justwatch },
];
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.title}</title>
    <meta name="description" content={c.desc} />
    <meta name="theme-color" content="#120d0b" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline src="/theme.js"></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={abs(lang)} />
    <link rel="alternate" hreflang="es" href={abs('es')} />
    <link rel="alternate" hreflang="en" href={abs('en')} />
    <link rel="alternate" hreflang="x-default" href={abs('en')} />
    <meta property="og:title" content={c.title} />
    <meta property="og:description" content={c.desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:image" content={site + '/og.png'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://image.tmdb.org" />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><filter id="outline" x="-5%" y="-30%" width="110%" height="160%"><feMorphology in="SourceAlpha" operator="erode" radius="2" result="inside"/><feComposite in="SourceGraphic" in2="inside" operator="out"/></filter></svg>
    <div class="aurora"><i></i><i></i></div>
    <nav class="top">
      <a class="brand" href={href(lang, '')}><span class="ico" set:html={appIcon}></span>Mediaddict</a>
      <div class="links"><a href="#features">{c.nav.features}</a><a href="#data">{c.nav.data}</a><a href="#faq">{c.nav.faq}</a></div>
      <div class="navr">
      <button class="themebtn" type="button" data-theme-toggle aria-label={t.theme} title={t.theme} set:html={sunMoon}></button>
      <div class="lang">
        {lang === 'es' ? <b>ES</b> : <a href="/es/" hreflang="es" lang="es">ES</a>}
        {lang === 'en' ? <b>EN</b> : <a href="/" hreflang="en" lang="en">EN</a>}
      </div>
      </div>
    </nav>

    <main class="stage" id="features">
      <div class="scenes" id="scenes">
        <section class="scene on s1" data-go="progress">
          <h1>{c.s1.h1a}<br /><em>{c.s1.h1b}</em></h1>
          <p class="lead">{c.s1.lead}</p>
          <div class="cta-row">
            <a class="play" href={PLAY_URL}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#00d4ff" d="M3.6 2.4 13.5 12l-9.9 9.6c-.4-.3-.6-.8-.6-1.4V3.8c0-.6.2-1.1.6-1.4z"/><path fill="#00f076" d="M17 8.5 13.5 12 3.6 2.4c.5-.4 1.2-.4 1.8 0L17 8.5z"/><path fill="#ff3a44" d="m17 15.5-11.6 6.1c-.6.4-1.3.4-1.8 0L13.5 12 17 15.5z"/><path fill="#ffd000" d="m20.4 10.6-3.4-2.1L13.5 12 17 15.5l3.4-2c1.1-.7 1.1-2.2 0-2.9z"/></svg>
              <div><small>{c.play.small}</small><span>{c.play.name}</span></div>
            </a>
            <div class="hint"><span class="dot"></span>{c.s1.hint}</div>
          </div>
          <p class="tiny">{c.s1.tiny}</p>
        </section>
        <section class="scene sm" data-go="progress">
          <div class="sc"><h2>{c.m.tryH}</h2><p class="short">{c.m.tryL}</p></div>
        </section>
        <section class="scene s2" data-go="calendar">
          <div class="sc">
            <div class="bigtime">{c.s2.time}</div>
            <h2>{c.s2.h2a} <em>{c.s2.h2b}</em></h2>
            <p class="lead">{c.s2.lead}</p>
            <p class="short">{c.m.s2}</p>
            <div class="provline" id="provline"></div>
          </div>
        </section>
        <section class="scene s3" data-go="detail">
          <div class="sc">
            <h2>{c.s3.h2a}<br /><em>{c.s3.h2c}</em></h2>
            <p class="lead">{c.s3.lead}</p>
            <p class="short">{c.m.s3}</p>
          </div>
        </section>
        <section class="scene s4" data-go="watchlist">
          <div class="sc">
            <h2 class="words">{c.s4.words.map((w, i) => <><span data-w={c.s4.keys[i]}>{w}.</span>{' '}</>)}</h2>
            <p class="lead">{c.s4.lead}</p>
            <p class="short">{c.m.s4}</p>
          </div>
        </section>
      </div>
      <aside class="rail">
        <div class="sticky">
          <div class="tilt" id="tilt"><div class="phone3d" id="p3d">
            <div class="glow"></div>
            <div class="float f1"><span><b>{c.float.a[0]}</b> · {c.float.a[1]}</span></div>
            <div class="float f2"><span><b>{c.float.b[0]}</b> · {c.float.b[1]}</span></div>
            <div class="device"><div class="screenwrap"><div class="app" id="app" aria-label="Demo"></div></div></div>
          </div></div>
          <div class="cap" id="cap"></div>
          <div class="palette" id="palette"><span>{c.palette}</span></div>
        </div>
      </aside>
    </main>

    <section class="band2" id="data">
      <h2>{c.data.h2a}<br /><em>{c.data.h2b}</em></h2>
      <p class="lead">{c.data.lead}</p>
      <p class="fine">{c.data.fine}</p>
    </section>

    <section class="logos">
      <p>{c.logos}</p>
      <div class="tiles">
        {logos.map((l) => <a class={'tile ' + l.cls} href={l.href} target="_blank" rel="noopener" aria-label={l.name} title={l.name} set:html={l.svg}></a>)}
      </div>
    </section>

    <section class="faq" id="faq">
      <h2>{c.faqTitle}</h2>
      <div class="faqlist">
        {c.faq.map(([q, a, link]) => (
          <details><summary>{q}</summary><p>{a}{link ? <> <a href={href(lang, 'privacy')}>{t.privacy}</a>.</> : null}</p></details>
        ))}
      </div>
    </section>

    <footer class="foot">
      <div class="fl"><span class="ico" set:html={appIcon}></span> Mediaddict · © 2026</div>
      <p>{t.attrTmdb}</p>
      <p>{t.attrTrakt}</p>
      <p>{t.attrNotAffiliated}</p>
      <p><a href={href(lang, 'privacy')}>{t.privacy}</a> · <a href={href(lang, 'terms')}>{t.terms}</a> · <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
    </footer>

    <div id="app-icon" hidden set:html={appIcon}></div>
    <script type="application/json" id="demo" set:html={JSON.stringify(demo)}></script>
    <script is:inline src="/phone.js" defer></script>
  </body>
</html>
